{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "bigbase": {
      "type": "remote",
      "url": "https://mcp.bigbase.click/mcp"
    },
    "sqz": {
      "type": "local",
      "command": ["sqz-mcp"]
    },
    "ctxo": {
      "type": "local",
      "command": ["npx", "-y", "@ctxo/cli@0.11.4"]
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem@2026.7.10", ".", "/tmp"]
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking@2026.7.4"]
    }
  }
}
