      ],
      "type": "local"
    },
    "filesystem": {
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem@2026.7.10",
        "${BIGBASE_ROOT:-.}",
        "/tmp"
      ],
      "type": "local"
    },
    "sequential-thinking": {
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking@2026.7.4"
      ],
      "type": "local"
    },
    "sqz": {
      "command": [
        "sqz-mcp"
      ],
      "type": "local"
    }
  }
