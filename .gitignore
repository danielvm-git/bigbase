# Go
bigbase
bigbase-linux-amd64
bigbase-darwin-*
*.exe
*.test
*.out
vendor/

# Terraform state — never commit
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Actual vars file — contains secrets
terraform.tfvars

# Crash logs
crash.log
crash.*.log

# OCI keys — just in case
*.pem
bigbase.db
data/
.bigpowers/
*.zip

# Node / semantic-release
node_modules/

# Environment (secrets)
.env

# macOS
.DS_Store

# Playwright E2E
test-results/
playwright-report/

# Frontend build artifacts (rebuildable)
/ui/dist/
/packages/*/dist/

# Allure — generated artifacts, never committed
allure-results/
allure-report/
allure-history/


# Ctxo local cache (auto-rebuilt, never committed)
.ctxo/.cache/
.ctxo/index/

# Dev tooling (local-only)
.bts.toml
.envrc
.rtk/
.vscode/mcp.json
.greptile/
.pi/

# Cursor IDE local config (may contain API keys)
.cursor/

# Python bytecode
__pycache__/

# Test-generated git repos (must be created in t.TempDir() only)
repo-*.git
bigbase_linux
