.env

# macOS
.DS_Store

# Playwright E2E
test-results/
playwright-report/

# Frontend build artifacts (rebuildable)
/ui/dist/
/packages/*/dist/

# Allure — generated artifacts, never committed
allure-results/
allure-report/
allure-history/


# Ctxo local cache (auto-rebuilt by the versioned hooks in .githooks/ — full
# rebuild on source commits via pre-commit, full rebuild on pull/merge via
# post-merge; never committed — every index JSON embeds a lastModified
# timestamp, so a committed baseline would dirty all files on each rebuild;
# verify-index is additionally upstream-broken: its temp comparison build runs
# with default config and cannot match the configured index. Freshness is
# hook-managed.)
.ctxo/*
!.ctxo/config.yaml

# Dev tooling (local-only)
.bts.toml
.envrc
.rtk/
.vscode/mcp.json
.greptile/
.pi/
.mimocode/
mimocode.jsonc
<stdin>
.agents/mcp_config.json
agentic-cps/

# Cursor IDE local config (may contain API keys)
.cursor/

# Python bytecode
__pycache__/

# Generated docs (regenerated by gate-trace / skills)
specs/TRACEABILITY_LATEST.md

# Test-generated git repos (must be created in t.TempDir() only)
repo-*.git

# Ctxo local cache (never committed)
.ctxo/.cache/
.zcode/

# IDE / local workspace artifacts
.claude/
specs/.obsidian/
