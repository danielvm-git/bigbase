#!/usr/bin/env bash
set -euo pipefail

echo "🔍 Running pre-commit checks..."

STAGED_GO=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)

if [ -n "$STAGED_GO" ]; then
    echo "   golangci-lint..."
    echo "$STAGED_GO" | xargs -I{} dirname {} | sort -u | xargs -I{} golangci-lint run ./{} 2>&1 | head -30

    echo "   go vet..."
    go vet ./... 2>&1 | head -20
fi

# Check for secrets in staged files.
# Patterns require real key entropy (length + charset), not bare prefixes:
# the old 'sk-' matched any prose containing "task-"/"risk-", and bare
# '-----BEGIN' matched public certs. Real formats caught:
#   sk_live_/sk_test_ (Stripe), sk-proj-/sk-ant- (OpenAI/Anthropic),
#   ghp_ (GitHub PAT), AKIA (AWS access key id), xoxb-/xoxa- (Slack),
#   PEM PRIVATE KEY blocks (RSA/EC/OPENSSH/PGP/DSA/ENCRYPTED).
echo "   scanning for secrets..."
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
if [ -n "$STAGED_FILES" ]; then
    SECRET_PATTERN='(^|[^A-Za-z0-9])(sk[_-](live|test)_?[A-Za-z0-9]{16,}|sk-(ant|proj|realtime)[A-Za-z0-9-]{20,}|sk-[A-Za-z0-9]{40,}|ghp_[A-Za-z0-9]{16,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}|-----BEGIN (RSA |EC |OPENSSH |PGP |DSA |ENCRYPTED )?PRIVATE KEY)'
    SECRETS=$(printf '%s\n' "$STAGED_FILES" | grep -v '^\.githooks/' | xargs -r grep -rnE -- "$SECRET_PATTERN" 2>/dev/null || true)
    if [ -n "$SECRETS" ]; then
        echo "❌ BLOCKED: Potential secrets found in staged files:"
        echo "$SECRETS"
        exit 1
    fi
fi

# Refresh the ctxo codebase index when source files changed, so MCP
# queries never serve stale symbol data (e89: landing/docs drift guard).
STAGED_SRC=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(go|ts|tsx|js|jsx)$' || true)
if [ -n "$STAGED_SRC" ]; then
    echo "   ctxo index..."
    if command -v ctxo >/dev/null 2>&1; then
        ctxo index >/dev/null 2>&1 || echo "   ⚠ ctxo index failed (check .ctxo config)"
    else
        echo "   ⚠ ctxo not installed — index not refreshed"
    fi
fi

echo "✅ Pre-commit checks passed"
