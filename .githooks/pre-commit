#!/usr/bin/env bash
set -euo pipefail

echo "🔍 Running pre-commit checks..."

STAGED_GO=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)

if [ -n "$STAGED_GO" ]; then
    echo "   golangci-lint..."
    echo "$STAGED_GO" | xargs -I{} dirname {} | sort -u | xargs -I{} golangci-lint run ./{} 2>&1 | head -30

    echo "   go vet..."
    go vet ./... 2>&1 | head -20
fi

# Check for secrets in staged files
echo "   scanning for secrets..."
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
if [ -n "$STAGED_FILES" ]; then
    SECRETS=$(echo "$STAGED_FILES" | tr ' ' '\n' | grep -v '^\.githooks/' | xargs grep -rn 'sk-\|ghp_\|AKIA\|xoxb-\|-----BEGIN' 2>/dev/null || true)
    if [ -n "$SECRETS" ]; then
        echo "❌ BLOCKED: Potential secrets found in staged files:"
        echo "$SECRETS"
        exit 1
    fi
fi

# Refresh the ctxo codebase index when source files changed, so MCP
# queries never serve stale symbol data (e89: landing/docs drift guard).
STAGED_SRC=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(go|ts|tsx|js|jsx)$' || true)
if [ -n "$STAGED_SRC" ]; then
    echo "   ctxo index..."
    if command -v ctxo >/dev/null 2>&1; then
        ctxo index >/dev/null 2>&1 || echo "   ⚠ ctxo index failed (check .ctxo config)"
    else
        echo "   ⚠ ctxo not installed — index not refreshed"
    fi
fi

echo "✅ Pre-commit checks passed"
