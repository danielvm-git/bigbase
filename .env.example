# Copy to .env (gitignored). Shared by local development tools and agent clients.

# Required for encrypted project/site secrets. Generate locally with:
#   openssl rand -base64 32
BIGBASE_ROOT_ENCRYPTION_KEY=

# Disable Claude Code compatibility fallbacks when using OpenCode.
OPENCODE_DISABLE_CLAUDE_CODE=1
OPENCODE_DISABLE_CLAUDE_CODE_PROMPT=1
OPENCODE_DISABLE_CLAUDE_CODE_SKILLS=1

# Provider key for local Context7 MCP access (optional for public docs).
CONTEXT7_API_KEY=

# GitHub CLI uses `gh auth login` — optional token for Actions only.
GITHUB_TOKEN=
