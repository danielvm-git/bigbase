# Copy to .env (gitignored). OpenCode-only — no Cursor/Claude/Gemini/Antigravity.

# Disable Claude Code compatibility fallbacks
OPENCODE_DISABLE_CLAUDE_CODE=1
OPENCODE_DISABLE_CLAUDE_CODE_PROMPT=1
OPENCODE_DISABLE_CLAUDE_CODE_SKILLS=1

# Provider keys for local `opencode` sessions
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# GitHub CLI uses `gh auth login` — optional token for Actions only:
# GITHUB_TOKEN=
