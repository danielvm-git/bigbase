# Copy to .env (gitignored) and fill in as needed.
#
# Two independent concerns live here:
#   1. BigBase server runtime env (the binary reads these — see config/required.env
#      for the keys the deploy preflight hard-requires).
#   2. Local `opencode` session env (agent tooling only).

# ── BigBase server (runtime) ────────────────────────────────────────────────
# REQUIRED in production. Base64-encoded 32 bytes. Generate with:
#   openssl rand -base64 32
# Startup fails hard if unset (unless BIGBASE_ENV=development and
# BIGBASE_ALLOW_PLAINTEXT_SECRETS=true). See config/required.env.
BIGBASE_ROOT_ENCRYPTION_KEY=

# production | development
BIGBASE_ENV=production

# Database (defaults: sqlite / bigbase.db). For postgres set a full DSN.
BIGBASE_DB_DRIVER=sqlite
BIGBASE_DB_DSN=

# Public base URL + parent domain for deployed sites.
BIGBASE_PUBLIC_URL=
BIGBASE_SITES_DOMAIN=

# OAuth (optional — enables Google sign-in).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub App (optional — enables forge/webhooks).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# Dev-only escape hatch: allow plaintext secrets when BIGBASE_ENV=development.
# BIGBASE_ALLOW_PLAINTEXT_SECRETS=false

# ── Local opencode session (agent tooling) ──────────────────────────────────
# Disable Claude Code compatibility fallbacks
OPENCODE_DISABLE_CLAUDE_CODE=1
OPENCODE_DISABLE_CLAUDE_CODE_PROMPT=1
OPENCODE_DISABLE_CLAUDE_CODE_SKILLS=1

# Provider keys for local `opencode` sessions
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# GitHub CLI uses `gh auth login` — optional token for Actions only:
# GITHUB_TOKEN=
